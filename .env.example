# ─── Banco de dados ───────────────────────────────────────────────
# Qualquer PostgreSQL 13+ (local, Docker, VPS ou Supabase).
# Supabase: botão "Connect" → URI do "Transaction pooler" (porta 6543, ideal no Vercel) ou "Session pooler" (5432).
DATABASE_URL=postgres://lp:lp@localhost:5432/lp
# docker-compose.yml (VPS): senha do Postgres, OBRIGATÓRIA. Use a mesma senha na DATABASE_URL se ela for definida aqui.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# "true" para conexões que exigem SSL (Supabase, RDS, etc.)
DATABASE_SSL=false

# ─── Servidor ─────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development
# URL pública do sistema (usada para montar as URLs das Landing Pages)
APP_URL=http://localhost:5173
# Hosts do próprio sistema (separados por vírgula). Qualquer outro host
# recebido é tratado como domínio personalizado de uma Landing Page.
APP_HOSTS=localhost,127.0.0.1

# ─── Autenticação ─────────────────────────────────────────────────
# OBRIGATÓRIO em produção (NODE_ENV=production): mínimo 32 caracteres, aleatório e exclusivo.
# Também deriva a chave que criptografa as chaves de API salvas: trocar depois exige recadastrá-las.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Só durante a troca do segredo: o valor antigo (sessões, chaves salvas e webhook continuam valendo; apague depois)
# JWT_SECRET_PREVIOUS=
# Administrador criado automaticamente na primeira inicialização (em produção, a senha de exemplo é recusada)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# ─── IA (somente no backend — nunca exposta ao navegador) ─────────
# Provedor de IA: "anthropic" (Claude) ou "gemini" (Google)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5 (anthropic) ou gemini-2.5-flash (gemini)
AI_MODEL=
# Somente se a chave NÃO estiver vinculada a um workspace (console.anthropic.com → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Google Gemini — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos reserva se o principal estiver sobrecarregado (padrão gemini: gemini-2.5-flash)
AI_FALLBACK_MODELS=

# ─── Armazenamento de arquivos ────────────────────────────────────
# "local" grava em ./uploads (servido em /uploads). Preparado para S3 no futuro.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ─── Observabilidade (opcional; sem nada definido fica desligada) ──
# Sentry: erros e desempenho da API. DSN em sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=
# Fração das requisições medidas (0 a 1). Padrão 0.1
SENTRY_TRACES_SAMPLE_RATE=
# Painel: DSN embutido no build (pode ser o mesmo projeto). Os relatórios passam por /api/monitoring
VITE_SENTRY_DSN=
# Só se o painel usar outro projeto do Sentry: o túnel aceita o DSN daqui (senão o SENTRY_DSN)
SENTRY_DSN_WEB=
# Sem Sentry: OpenTelemetry via OTLP para qualquer fornecedor (Datadog, New Relic, Grafana...)
# Ex.: OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net  OTEL_EXPORTER_OTLP_HEADERS=api-key=...
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=lp-api

# E-mail do formulário de contato das LPs (as mensagens vão para o e-mail cadastrado na empresa)
# Opção 1 — SMTP (ex.: Gmail com "senha de app": SMTP_HOST=smtp.gmail.com, SMTP_PORT=465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opção 2 — Resend (exige domínio verificado no Resend para o remetente)
RESEND_API_KEY=
# Remetente (padrão: SMTP_USER). A resposta vai direto para quem preencheu o formulário.
MAIL_FROM=

# Galeria de GIFs do WhatsApp do CRM (chave gratuita em https://developers.giphy.com → Create an App → API)
GIPHY_API_KEY=

# Domínios próprios das LPs na Vercel: com o token, o domínio salvo na LP é adicionado ao projeto sozinho
# (Vercel → Account Settings → Tokens). Equipe: o "orgId" de .vercel/project.json (team_…).
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=crialp
