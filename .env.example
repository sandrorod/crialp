# ─── Banco de dados ───────────────────────────────────────────────
# Qualquer PostgreSQL 13+ (local, Docker, VPS ou Supabase).
# Supabase: botão "Connect" → URI do "Transaction pooler" (porta 6543, ideal no Vercel) ou "Session pooler" (5432).
DATABASE_URL=postgres://lp:lp@localhost:5432/lp
# "true" para conexões que exigem SSL (Supabase, RDS, etc.)
DATABASE_SSL=false

# ─── Servidor ─────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development
# URL pública do sistema (usada para montar as URLs das Landing Pages)
APP_URL=http://localhost:5173
# Hosts do próprio sistema (separados por vírgula). Qualquer outro host
# recebido é tratado como domínio personalizado de uma Landing Page.
APP_HOSTS=localhost,127.0.0.1

# ─── Autenticação ─────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Administrador criado automaticamente na primeira inicialização
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# ─── IA (somente no backend — nunca exposta ao navegador) ─────────
# Provedor de IA: "anthropic" (Claude) ou "gemini" (Google)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5 (anthropic) ou gemini-2.5-flash (gemini)
AI_MODEL=
# Somente se a chave NÃO estiver vinculada a um workspace (console.anthropic.com → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Google Gemini — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos reserva se o principal estiver sobrecarregado (padrão gemini: gemini-2.5-flash)
AI_FALLBACK_MODELS=

# ─── Armazenamento de arquivos ────────────────────────────────────
# "local" grava em ./uploads (servido em /uploads). Preparado para S3 no futuro.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
