{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{js,mjs}"
      ],
      "project": [
        "scripts/**"
      ]
    },
    "apps/api": {
      "entry": [
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@lp/web"
      ]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx",
        "src/lib/*Worker.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    }
  }
}
