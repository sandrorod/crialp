{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Teste de mutação (npm run test:mutation -w apps/web): só nos módulos com testes unitários. Lento; roda no CI semanal. Nota inicial: 69,4% (break em 65 para não regredir).",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/lib/richText.ts",
    "src/lib/utils.ts",
    "src/lib/lpBatch.ts",
    "src/lib/colorTones.ts",
    "src/components/landing/imageStyle.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 65
  },
  "tempDirName": ".stryker-tmp"
}
